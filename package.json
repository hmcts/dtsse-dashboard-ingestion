{
  "name": "dtsse-dashboard-ingestion",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "start": "AZURE_LOG_LEVEL=info NODE_ENV=production timeout 3600 ts-node src/main/run.ts",
    "start:dev": "timeout 600 ts-node -r dotenv/config src/main/run.ts",
    "lint": "yarn eslint . --ext .js,.ts && prettier --check .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "build": "exit 0",
    "test": "npx if-env CI=true && exit 0 || yarn test:unit",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:a11y": "exit 0",
    "cichecks": "yarn lint && yarn test",
    "migration:create": "ts-node -r dotenv/config src/main/run.ts create --",
    "migration:down": "yarn start:dev down"
  },
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@azure/cosmos": "^4.9.3",
    "@azure/identity": "^4.13.1",
    "@eslint/js": "^10.0.1",
    "@hmcts/properties-volume": "^1.4.0",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pg-format": "^1.0.5",
    "axios": "^1.18.0",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.8.0",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "globals": "^17.7.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "pg-format": "^1.0.4",
    "tough-cookie": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.4",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.11"
  }
}
